{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // scripts run through tsx & never land in dist => no rootDir/emit constraints
    "noEmit": true,
    "rootDir": "."
  },
  // everything outside src/ that still has to typecheck => scripts, the vitest suite & its config
  "include": ["scripts/**/*", "test/**/*", "vitest.config.ts"]
}

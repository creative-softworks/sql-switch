# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file for the sql-switch repo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses trailing whitespace for hard line breaks, so leave it alone.
[*.md]
trim_trailing_whitespace = false
